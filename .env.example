# Repository and external source roots
WAM_OPD_ROOT=/path/to/WAM-OPD
WAVE_RL_ROOT=/path/to/wave-rl

# Use the RoboTwin/LingBot runtime rather than the system Python for GPU runs.
WAM_OPD_PYTHON_BIN=/path/to/wave-rl/third_party/RLinf/.venv-robotwin/bin/python

# Large data stays outside Git.
WAM_OPD_ARTIFACT_ROOT=/path/to/artifacts/WAM-OPD
WAM_OPD_CONFIG_ROOT=/path/to/WAM-OPD/configs/generated
WAM_OPD_STUDENT_ROOT=/path/to/FlashWAM-RoboTwin
WAM_OPD_TEACHER_ROOT=/path/to/lingbot-va-posttrain-robotwin
WAM_OPD_SOURCE_SWEEP=/path/to/robotwin_native_sweep/raw/demo_clean
WAM_OPD_OUTPUT_ROOT=/path/to/artifacts/WAM-OPD/experiments
WAM_OPD_SCRATCH_ROOT=/path/to/scratch/WAM-OPD
WAM_OPD_OBSERVATION=/path/to/saved_three_camera_observation.pt
